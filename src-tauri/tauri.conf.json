{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zapret2-gui",
  "version": "0.1.0",
  "identifier": "com.zapret2.gui",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Zapret2 Manager",
        "width": 900,
        "height": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": null
      }
    }
  }
}
